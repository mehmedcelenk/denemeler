    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "katex": "^0.19.0"
  }
